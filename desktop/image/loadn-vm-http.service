[Unit]
# 桌面壳 HTTP 通道（mac/VZ 形态）：vsock 8792 → VM 内 TCP 8792（loadn-vm serve）。
# vfkit 侧 host unix socket ↔ guest vsock 8792（壳的 relay 桥 WebView 流量）；
# guest 侧需要本单元把 vsock 端口桥到 serve 的 TCP 端口。WSL 形态走
# localhostForwarding（无 /dev/vsock，ConditionPathExists 自然跳过）。
ConditionPathExists=/dev/vsock
After=systemd-modules-load.service loadn-vm.service

[Service]
Type=simple
User=loadn
ExecStartPre=-/sbin/modprobe vmw_vsock_virtio_transport
ExecStart=/usr/bin/socat VSOCK-LISTEN:8792,reuseaddr,fork TCP-CONNECT:127.0.0.1:8792
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
